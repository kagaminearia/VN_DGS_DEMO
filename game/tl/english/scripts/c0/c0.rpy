    by eye_wacky o "...Huh? You don’t even know what CSA is, but you know this is it?\nIt is so strange..."

# game/scripts/c0/c0.rpy:248
translate english ch0_3f2433ad:

    # by eye_def e "就是{b}城市安全管理局{/b}啊，看名字就懂了吧。"
