    by eye_still o "{size=23}Someone will come in later, I can't talk to you like this...If you really can {b}see{/b} something, tell me.{/size}"

# game/scripts/c0/c0.rpy:257
translate english ch0_908ebcda:

    # "她的声音越来越小，几乎只是在喉咙口吹气。除了能感受到她身体的我，大概没人能听清。"
    "Her voice faded to a whisper, little more than air pushed past her throat. No one else could have heard it—only me, who can feel her body."

# game/scripts/c0/c0.rpy:258
translate english ch0_55a95495:

    # me "好。"
    me "Okay."

# game/scripts/c0/c0.rpy:262
