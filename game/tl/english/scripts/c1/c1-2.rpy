# game/scripts/c1/c1-2.rpy:3
translate english ch1_2_8a5ffef2:

    # me "检查结果明天才出来。"
    me "The test results will be out tomorrow."

# game/scripts/c1/c1-2.rpy:4
translate english ch1_2_7ff6ebfa:

    # by eye_def o "啥？我知道啊？"
    by eye_def o "Huh? I know."

# game/scripts/c1/c1-2.rpy:5
translate english ch1_2_1ed3ed8b:

    # me "呃……我是想说……明天才知道，你现在不用这么，紧张？"
    me "Uh... I mean... we'll know tomorrow, so you don't need to be so, nervous?"

# game/scripts/c1/c1-2.rpy:6
translate english ch1_2_29c5bb1a:

    # by eye_def def "……"
    by eye_def def "..."

# game/scripts/c1/c1-2.rpy:7
translate english ch1_2_d590da29:

    # by eye_wacky e "哈？你觉得我在紧张吗？"
    by eye_wacky e "Huh? Do you think I'm nervous?"

# game/scripts/c1/c1-2.rpy:8
translate english ch1_2_d9d5e071:

    # me "不是吗，那你为什么一直在床上滚来滚去。"
    me "Isn't it? Then why have you been tossing and turning in bed?"

# game/scripts/c1/c1-2.rpy:9
translate english ch1_2_2aa40531:

    # me "能别转了么，弄得我头很晕啊……"
    me "Can you stop spinning? It's making me dizzy..."

# game/scripts/c1/c1-2.rpy:10
translate english ch1_2_ef2ffdac:

    # by eye_close o "不能，忍着。"
    by eye_close o "No. Bear it."

# game/scripts/c1/c1-2.rpy:11
translate english ch1_2_1834d120:

    # me "……"
    me "..."

# game/scripts/c1/c1-2.rpy:12
translate english ch1_2_ab59d555:

    # me "你——"
    me "Hey you..."

# game/scripts/c1/c1-2.rpy:13
translate english ch1_2_fb8744e8:

    # by eye_close e "我没紧张。"
    by eye_close e "I am not nervous."

# game/scripts/c1/c1-2.rpy:14
translate english ch1_2_ee1aad4f:

    # "白一飞快地接话。"
    "Bai Yi quickly took over the conversation."

# game/scripts/c1/c1-2.rpy:15
translate english ch1_2_c75b66b3:

    # me "哦……好吧，你没紧张。"
    me "Oh...Okay? You are not nervous, ok."

# game/scripts/c1/c1-2.rpy:16
translate english ch1_2_04a5d09e:

    # me "不过，你是不是忘了我能感觉到——"
    me "But have you forgotten that I can feel—"

# game/scripts/c1/c1-2.rpy:17
translate english ch1_2_18d8c34d:

    # by eye_shock o "{size=45}都说了你感觉错了！{/size}"
    by eye_shock o "{size=45}I told you that you were wrong!{/size}"

# game/scripts/c1/c1-2.rpy:18
translate english ch1_2_ec1d91ef:

    # by eye_shock def "……"
    by eye_shock def "..."

# game/scripts/c1/c1-2.rpy:19
translate english ch1_2_35f12038:

    # by eye_close e "{size=23}啊……算了……{/size}"
    by eye_close e "{size=23}Well, nevermind...{/size}"

# game/scripts/c1/c1-2.rpy:20
translate english ch1_2_cf8c0bf6:

    # by eye_close o "我只是，现在想起来，还是觉得很不真实罢了。"
    by eye_close o "I just, now that I think about it, still feel very unreal."

# game/scripts/c1/c1-2.rpy:21
translate english ch1_2_b636be02:

    # "有人死了，曾经死过，杀人嫌疑……\n一切都不真实。"
    "Someone died. I had died. I was suspected of murder...\nEverything was unreal."

# game/scripts/c1/c1-2.rpy:22
translate english ch1_2_d8e85dd1:

    # me "嗯……也对。"
    me "Well...You're right."

# game/scripts/c1/c1-2.rpy:23
translate english ch1_2_737efe6d:

    # "白一在床上打滚的动作停下后，房间变得很安静，只有她的心脏在慢慢跳动。"
    "After Bai Yi stopped tossing on the bed, the room fell quiet, filled only with the slow beat of her heart."

# game/scripts/c1/c1-2.rpy:24
translate english ch1_2_30140074:

    # "就像她的情绪，变得平缓麻木，却也混杂着无所适从的迷茫，溶解在夜色之中。"
    "Just like her emotions, they became smooth and numb, but also mixed with disorientation and confusion, dissolving into the night."

# game/scripts/c1/c1-2.rpy:28
translate english ch1_2_fd64e54c:

    # by eye_close e "话说，温心她……其实我跟她不熟，毕竟只是同班同学。"
    by eye_close e "Speaking of Wen Xin, about her... Actually, I'm not familiar with her, after all, we're just classmates."

# game/scripts/c1/c1-2.rpy:29
translate english ch1_2_71d8338f:

    # by eye_move e "不过要这么说的话就没有同学跟我熟的……"
    by eye_move e "But if putting it that way, no classmates are familiar with me..."

# game/scripts/c1/c1-2.rpy:30
translate english ch1_2_8cb5ee97:

    # me "嗯。"
    me "Yeah."

# game/scripts/c1/c1-2.rpy:31
translate english ch1_2_35ee8f43:

    # "白一忽然开始嘀嘀咕咕。\n我不知道为什么她突然说这个，但我认为，这时候或许只是听着比较好……"
    "Bai Yi suddenly started to mutter to herself. \nI didn't know why she suddenly said this, but I thought that at this time it was probably better to just listen..."

# game/scripts/c1/c1-2.rpy:32
translate english ch1_2_9617051b:

    # by eye_close o "在学校里好像说过两句话，但我没印象了。"
    by eye_close o "I think we exchanged a couple of words at school, but I don't remember."

# game/scripts/c1/c1-2.rpy:33
translate english ch1_2_a2655f02:

    # by eye_close o "但是没印象说明也没发生过什么。"
    by eye_close o "But the fact that I don't remember anything suggests that nothing happened between her and me."

# game/scripts/c1/c1-2.rpy:34
translate english ch1_2_577273fe:

    # me "哦……嗯。"
    me "Hmm...well."

# game/scripts/c1/c1-2.rpy:36
translate english ch1_2_f539951f:

    # by eye_move e "所以，我真的会杀了她吗？我为什么要做这种脑残事？？"
    by eye_move e "So… did I really kill her? Why would I do something so stupid?"

# game/scripts/c1/c1-2.rpy:37
translate english ch1_2_27298cd1:

    # me "嗯……"
    me "Well..."

# game/scripts/c1/c1-2.rpy:38
translate english ch1_2_2ff2c06f:

    # me "既然你觉得不会……那就相信自己呗。"
    me "Since you don't think it will happen... then believe in yourself."

# game/scripts/c1/c1-2.rpy:39
translate english ch1_2_3ddd733e:

    # by eye_wacky smile "呵呵，我是很想相信，但现在也发生了很多事情。"
    by eye_wacky smile "Hehe, I really want to believe it, but a lot of things have happened now."

# game/scripts/c1/c1-2.rpy:40
translate english ch1_2_f23c9f4c:

    # by eye_close o "很多事情，我原本是不信的那些……"
    by eye_close o "There are many things that I didn't believe in before..."

# game/scripts/c1/c1-2.rpy:41
translate english ch1_2_76c13279:

    # "面对我苍白的安慰，她只是冷笑一声，啪地把被子扔到自己的头顶。"
    "She just gave a cold laugh at my pale comfort and threw the quilt over her head with a bang."

# game/scripts/c1/c1-2.rpy:43
translate english ch1_2_aa72bbe7:

    # by eye_close e "啊……真的烦死了……"
    by eye_close e "Ah... So annoying.."

# game/scripts/c1/c1-2.rpy:44
translate english ch1_2_d439f3b0:

    # "白一轻骂一声，之后就没再说些什么。"
    "Bai Yi cursed softly, and then said nothing more."

# game/scripts/c1/c1-2.rpy:45
translate english ch1_2_20f6e772:

    # "房间里再次变得沉默。"
    "And the room fell silent again."

# game/scripts/c1/c1-2.rpy:46
translate english ch1_2_34fcd3e2:

    # "被子被揉捏摩擦，发出细碎的声音，沙沙作响，仿若不安的心绪。"
    "The quilt was kneaded and rubbed, making a fine sound, rustling, as if it was an uneasy mood."

# game/scripts/c1/c1-2.rpy:47
translate english ch1_2_008de3f2:

    # "好在，不知何时，她已然被睡梦侵蚀。"
    "Fortunately, she had already been invaded by sleep at some point."

# game/scripts/c1/c1-2.rpy:58
translate english ch1_2_aefbeec0:

    # "熟悉的时间，熟悉的地方。"
    "Familiar time, familiar place."

# game/scripts/c1/c1-2.rpy:59
translate english ch1_2_e5317159:

    # "面无表情的西平，笑眯眯的西顺，以及满脸不爽的白一在一个房间。"
    "In the same room stood Xi Ping, expressionless; Xi Shun, smiling; and Bai Yi, her face full of displeasure."

# game/scripts/c1/c1-2.rpy:60
translate english ch1_2_ad9ff42d:

    # "——连表情也如此熟悉。"
    "...Even the expression is so familiar."

# game/scripts/c1/c1-2.rpy:62
translate english ch1_2_9c447a3d:

    # xs "今天的话，主要有三件事。"
    xs "Today we have three main things."

# game/scripts/c1/c1-2.rpy:63
translate english ch1_2_4bc560a5:

    # xs "第一个，结果出来了。你跟温心一样，是在差不多的时间服用安眠药的。"
    xs "First, the results are out. You and Wen Xin took sleeping pills at about the same time."

# game/scripts/c1/c1-2.rpy:64
translate english ch1_2_c9ba0990:

    # by eye_def def "哦。所以，这样能证明我不是凶手吗？"
    by eye_def def "Oh. So, this proves I'm not the murderer?"

# game/scripts/c1/c1-2.rpy:67
translate english ch1_2_2acc22b1:

    # xs "嗯——不能。"
    xs "Hmm...no."

# game/scripts/c1/c1-2.rpy:68
translate english ch1_2_6967bf3a:

    # xs "你现在重新活过来，而你自己有可能是知道这件事情的。"
    xs "You’ve come back to life now, and you might actually know that yourself."

# game/scripts/c1/c1-2.rpy:69
translate english ch1_2_f8dc7468:

    # xs "那么，理论上，所有关于你也是受害者的线索……都不一定可靠。"
    xs "So in theory, any clues suggesting you’re also a victim… aren’t necessarily reliable."

# game/scripts/c1/c1-2.rpy:70
translate english ch1_2_ca724315:

    # xs "比如安眠药，有可能是你自己吃的。因为你知道自己就算在那里晕倒中毒，之后也会重新活过来。"
    xs "Take the sleeping pills, for example. You could’ve taken them yourself. Because you knew that even if you passed out and got poisoned there, you’d wake up alive later."

# game/scripts/c1/c1-2.rpy:71
translate english ch1_2_83ab1346:

    # xs "那样如果你真是凶手，就很容易洗脱嫌疑了。"
    xs "If you really were the murderer, that would make it easy to clear your name."

# game/scripts/c1/c1-2.rpy:72
translate english ch1_2_6f8e24fb:

    # by eye_still o "……这不是完全没洗脱吗？"
    by eye_still o "…That doesn’t sound like being cleared at all."

# game/scripts/c1/c1-2.rpy:73
translate english ch1_2_1490f5a8:

    # xs "那是因为时机不对。"
    xs "“That’s because the timing was off."

# game/scripts/c1/c1-2.rpy:74
translate english ch1_2_26e46969:

    # xs "如果没有被特案组发现，你就是一个很倒霉，但也很幸运的受害者。"
    xs "If the SIUhadn’t found out, you'd just be a very unlucky—but also very lucky—victim."

# game/scripts/c1/c1-2.rpy:75
translate english ch1_2_f5babd59:

    # by eye_still o "……很倒霉，因为“不小心”吃了药，在房间里中毒。很幸运，因为虽然中毒，却没有死亡？"
    by eye_still o "…Unlucky because I ‘accidentally’ took the pills and got poisoned in my room. Lucky because I didn’t die despite it?"

# game/scripts/c1/c1-2.rpy:76
translate english ch1_2_f77fbcb7:

    # xs "对，聪明。"
    xs "Exactly. Smart."

# game/scripts/c1/c1-2.rpy:77
translate english ch1_2_00b06a88:

    # by eye_wacky def "……"
    by eye_wacky def "..."

# game/scripts/c1/c1-2.rpy:78
translate english ch1_2_ebee1837:

    # "总而言之，因为白一突然“死而复生”，整件事情变得更加复杂。"
    "All in all, the whole thing has become more complicated because Bai Yi suddenly came back to life."

# game/scripts/c1/c1-2.rpy:79
translate english ch1_2_33c2caf0:

    # "除非有直接能够指认凶手的证据，否则，作为目前唯一被证明在案发现场的，还和怪异有联系的人，白一很难清除嫌疑。"
    "Unless there’s direct evidence pointing to the real murderer, Bai Yi — the only person proven to have been at the scene and tied to the anomaly — will have a hard time shaking suspicion."

# game/scripts/c1/c1-2.rpy:80
translate english ch1_2_2839f740:

    # by eye_wacky e "那你说这么多，说个屁啊。查出来有什么用？不还是一样。"
    by eye_wacky e "Then what’s the point of saying all that? What good does solving it do? Wouldn’t it still be the same?"

# game/scripts/c1/c1-2.rpy:83
translate english ch1_2_0187da05:

    # xs "不，信息越多，就离真相越近。"
    xs "No, the more information, the closer to the truth."

# game/scripts/c1/c1-2.rpy:86
translate english ch1_2_9d2e834d:

    # xs "一件件查下去，会找到的。"
    xs "We'll finally find it if we check each item."

# game/scripts/c1/c1-2.rpy:87
translate english ch1_2_1c9f7ddf:

    # by eye_move def "……行，你说是就是吧。"
    by eye_move def "...Okay, whatever you say."

# game/scripts/c1/c1-2.rpy:88
translate english ch1_2_923b9d76:

    # "白一对此毫无兴趣，也懒得和西顺争论。"
    "Bai Yi had no interest in this and was too lazy to argue with Xi Shun."

# game/scripts/c1/c1-2.rpy:91
translate english ch1_2_d968f515:

    # xs "嗯，那继续说第二件事。之前，不是要给你做检查吗，就顺便多检查了一些项目。"
    xs "Well, then let‘s continue with the second thing. Wasn't it supposed to be a checkup for you? So I checked out a few more items while I was at it."

# game/scripts/c1/c1-2.rpy:94
translate english ch1_2_04f67cdc:

    # xs "结合你的情况，我也查了一些以前的资料……我大概能确认，你身上的怪异是怎么回事。"
    xs "Combining your situation, I also checked some previous information... I can roughly confirm what the GuaiYi about you is about."

# game/scripts/c1/c1-2.rpy:95
translate english ch1_2_73d5021f:

    # by eye_still o "什么？真的？"
    by eye_still o "What? Really?"

# game/scripts/c1/c1-2.rpy:98
translate english ch1_2_98035911:

    # "白一愣了愣，而后，不知为何，微微皱了皱眉。"
    "Bai Yi froze. A moment later, she frowned, as if something had suddenly gone wrong."

# game/scripts/c1/c1-2.rpy:99
translate english ch1_2_02c6d1d8:

    # "某种不知名的情绪浮现，似是不满，还有藏在不满心情下的紧张。"
    "An emotion I couldn’t name rose in her eyes — almost dissatisfaction, but tighter, sharper, threaded with tension."

# game/scripts/c1/c1-2.rpy:100
translate english ch1_2_f6f071fe:

    # "被她的情绪感染，我也变得紧张起来。"
    "It spread to me before I realized it, my breath turning shallow."

# game/scripts/c1/c1-2.rpy:101
translate english ch1_2_e905861d:

    # "西顺说的是那个意思吗？她是弄清楚什么了吗？然后……是要解决吗？"
    "Was this what Xi Shun meant? Had she noticed something?\nAnd if she had… was she about to unravel it?"

# game/scripts/c1/c1-2.rpy:104
translate english ch1_2_2fd8e971:

    # xs "你身上的情况，和一种古老的诅咒有相似之处。"
    xs "What’s happening to you bears a resemblance to an ancient curse."

# game/scripts/c1/c1-2.rpy:105
translate english ch1_2_a3f30db2:

    # xs "这种诅咒会在被诅咒的人受到致命伤害的时候生效，让身体进入一段时间的假死状态，随后恢复，避开真正的死亡。"
    xs "This kind of curse will take effect when the cursed person is fatally injured, allowing the body to enter a state of false death for a period of time, then recover, avoiding real death."

# game/scripts/c1/c1-2.rpy:106
translate english ch1_2_cf3f8058:

    # xs "诅咒生效之后，被咒的人会忘记死因，以及死前相关的事情。"
    xs "After the curse takes effect, the cursed person will forget the cause of death, as well as the related matters before death."

# game/scripts/c1/c1-2.rpy:107
translate english ch1_2_67d43dc3:

    # xs "所以，你才会出现短暂性失忆的情况。"
    xs "That’s the reason behind your temporary amnesia."

# game/scripts/c1/c1-2.rpy:110
translate english ch1_2_0ab82fd6:

    # xs "不过……避开死亡并不是无条件的，它会导致不可预知的副作用。"
    xs "However… escaping death does not come without a price. The curse brings unpredictable side effects."

# game/scripts/c1/c1-2.rpy:111
translate english ch1_2_37b7133a:

    # xs "还有就是，它现在只是相当于延缓了你的死亡，如果不彻底解除诅咒，你还是会在三个月之后死掉。"
    xs "Also, it‘s now only equivalent to delaying your death. If the curse isn‘t completely lifted, you’ll still die in three months."

# game/scripts/c1/c1-2.rpy:112
translate english ch1_2_4d791901:

    # xs "只有你在诅咒生效后再彻底解除，你才能真正摆脱这一次的死亡危机。"
    xs "Only if you completely dispel the curse after it takes effect can you truly escape this death crisis."

# game/scripts/c1/c1-2.rpy:113
translate english ch1_2_bc07fda4:

    # by eye_still def "……"
    by eye_still def "..."

# game/scripts/c1/c1-2.rpy:114
translate english ch1_2_93681703:

    # "这消息实在突然，且信息量巨大。"
    "The news was so sudden and contained so much information."

# game/scripts/c1/c1-2.rpy:115
translate english ch1_2_acf802bd:

    # "以至于白一没有任何反应，只是呆呆地愣在原地。"
    "Bai Yi didn't react at all, but just stood there in a daze."

# game/scripts/c1/c1-2.rpy:116
translate english ch1_2_600772d8:

    # "西顺不得不停止说话，等着白一自己缓过来。"
    "Xi Shun had to stop talking, waiting for Bai Yi to calm down on her own."

# game/scripts/c1/c1-2.rpy:119
translate english ch1_2_c28d7675:

    # xs "你真的什么都想不起来吗？现在也是？"
    xs "Can't you really remember anything? Even now?"

# game/scripts/c1/c1-2.rpy:120
translate english ch1_2_62ba3e40:

    # by eye_wacky o "废话。不然呢？"
    by eye_wacky o "Of course. What else?"

# game/scripts/c1/c1-2.rpy:121
translate english ch1_2_c7abb1ff:

    # "情绪被打断，白一没什么好气地呛了一句。"
    "Interrupted in her emotions, Bai Yi retorted in a bad mood."

# game/scripts/c1/c1-2.rpy:122
translate english ch1_2_8e9adade:

    # "西顺只是耸耸肩，继续往下说。"
    "Xi Shun just shrugged and continued."

# game/scripts/c1/c1-2.rpy:125
translate english ch1_2_598e81ef:

    # xs "好了，我不是故意吊你胃口。"
    xs "Okay, I didn't mean to keep you in suspense."

# game/scripts/c1/c1-2.rpy:126
translate english ch1_2_963c9534:

    # xs "我提到这点，是因为要解除诅咒，需要你找回死亡时的记忆。"
    xs "I mention this because to lift the curse, you need to recover your memories of when you died."

# game/scripts/c1/c1-2.rpy:127
translate english ch1_2_e69e4068:

    # by eye_wacky e "……哈？！"
    by eye_wacky e "...What?"

# game/scripts/c1/c1-2.rpy:128
translate english ch1_2_48fa2ff8:

    # by eye_wacky def "这又是什么说法。"
    by eye_wacky def "What is this?"

# game/scripts/c1/c1-2.rpy:131
translate english ch1_2_627db224:

    # xs "别这么看我，我没骗你。"
    xs "Don't look at me like that, I'm not lying to you."

# game/scripts/c1/c1-2.rpy:134
translate english ch1_2_aecac5e3:

    # xs "等你想起来那段记忆，自然就知道该怎么做——嗯，资料上是这么说的。"
    xs "When you remember that memory, you will naturally know what to do - well, that's what the materials said."

# game/scripts/c1/c1-2.rpy:135
translate english ch1_2_82ea00a0:

    # by eye_still e "……所以……反正基本意思就是，我三个月之后还是会死咯。"
    by eye_still e "...So... basically what you're saying is that I'm still going to die in three months."

# game/scripts/c1/c1-2.rpy:138
translate english ch1_2_d60001b4:

    # xs "也许，如果找不到解决方法的话。是的。"
    xs "Maybe, if there's no solution. Yes."

# game/scripts/c1/c1-2.rpy:139
translate english ch1_2_2198c8e4:

    # by eye_still "……"
    by eye_still "..."

# game/scripts/c1/c1-2.rpy:140
translate english ch1_2_e94063b6:

    # by eye_close o "哦……"
    by eye_close o "Okay..."

# game/scripts/c1/c1-2.rpy:141
translate english ch1_2_5f7f7069:

    # by eye_def e "等等，那我被附身的事情呢？这又是因为什么？"
    by eye_def e "Wait, what about me being possessed? Why is that?"

# game/scripts/c1/c1-2.rpy:142
translate english ch1_2_54ad9bf8:

    # "想不通，白一干脆转移了对话，好似这样就能撇开胸口那股烦闷的感觉。"
    "Unable to figure it out, Baiyi simply changed the conversation, as if this would help her get rid of the nagging feeling in her chest."

# game/scripts/c1/c1-2.rpy:143
translate english ch1_2_27ef85fa:

    # "只是，急忙抛出来的话题，似乎也并没有好到哪里去。"
    "However, the topic that was hastily thrown out didn't seem to be much better."

# game/scripts/c1/c1-2.rpy:146
translate english ch1_2_4ccb25c2:

    # xs "嗯……这个还不知道。"
    xs "Well... I don't know yet."

# game/scripts/c1/c1-2.rpy:147
translate english ch1_2_912b6b52:

    # by eye_wacky e "哈？！"
    by eye_wacky e "What?!"

# game/scripts/c1/c1-2.rpy:148
translate english ch1_2_8db714a0:

    # xs "但是我们认为，这就是呈现在你身上副作用。只是不知道为什么会是这种形式。{size=23}之前没出现过，也没听说过，会联系到完全不相关的人身上……{/size}"
    xs "But we believe that this is the side effect that is present in you. We just don‘t know why it would take this form. {size=23} It has never appeared before, nor have we heard of it, and it will be linked to completely unrelated people... {/size}"

# game/scripts/c1/c1-2.rpy:149
translate english ch1_2_00b06a88_1:

    # by eye_wacky def "……"
    by eye_wacky def "..."

# game/scripts/c1/c1-2.rpy:150
translate english ch1_2_834d9107:

    # "怎么感觉不太靠谱……"
    "Seems a bit iffy..."

# game/scripts/c1/c1-2.rpy:153
translate english ch1_2_be919868:

    # xs "所以我说，是古老诅咒的相似类型。你和你的小鬼魂这种情况，在记录里从来没有过——啊，当然这次以后就会有了。"
    xs "So I said, it‘s a similar type of ancient curse. This situation with you and your little ghost, it‘s never been recorded before — well, of course it will be after this time."

# game/scripts/c1/c1-2.rpy:154
translate english ch1_2_9b7d8753:

    # by eye_still def "这算什么。"
    by eye_still def "What kind of answer is this?"

# game/scripts/c1/c1-2.rpy:157
translate english ch1_2_74af512d:

    # xs "但一定要解释的话，只能说，怪异本就无法用常理判断，世界上的怪异也千变万化。"
    xs "But if I must explain, I can only say that strangeness cannot be judged by common sense, and the strangeness in the world is very varied."

# game/scripts/c1/c1-2.rpy:160
translate english ch1_2_f207eea4:

    # xs "用我们的话说，你遇到了，这就是属于你的“缘”。"
    xs "In our words, you have met, this is your “Yuan”(Fate)."

# game/scripts/c1/c1-2.rpy:161
translate english ch1_2_51ba36b0:

    # xs "可能你们就是有缘分吧。"
    xs "Maybe you guys are fated to meet."

# game/scripts/c1/c1-2.rpy:162
translate english ch1_2_8090aace:

    # by eye_wacky o "{size=23}并不是很想要这种缘分……{/size}"
    by eye_wacky o "{size=23}I don't want that fate...{/size}"

# game/scripts/c1/c1-2.rpy:165
translate english ch1_2_000322a1:

    # xs "不过，可以确定的是，她因为诅咒绑定你，自然和附身的诅咒一样，有类似的特性。"
    xs "However, what is certain is that she is bound to you because of the curse. Naturally, it has similar characteristics to the curse of possession."

# game/scripts/c1/c1-2.rpy:168
translate english ch1_2_1ae18772:

    # xs "她附着你的身体，会消耗你的生命力，当然，解除之后也会完全消失。"
    xs "Attached to your body, the ghost consumes your life force. Of course, this effect will cease completely once the curse is lifted."

# game/scripts/c1/c1-2.rpy:169
translate english ch1_2_ea31fe32:

    # xs "所以，你剩下的时间可能比三个月更短，最近的体质也会变差，算是副作用和诅咒本身的特性叠加起来了吧。"
    xs "So you may not even have three months left, and you’ll likely start getting weaker soon. That’s the side effects and the curse piling up."

# game/scripts/c1/c1-2.rpy:170
translate english ch1_2_5636da89:

    # by eye_close e "哦……"
    by eye_close e "Okay..."

# game/scripts/c1/c1-2.rpy:171
translate english ch1_2_020b205d:

    # by eye_def o "所以你是说，我身上有一个诅咒，然后它的副作用又给我加了一个诅咒，然后也有副作用。"
    by eye_def o "So you‘re saying, I had a curse on me, and then its side effect added another curse to me, and then there were side effects too."

# game/scripts/c1/c1-2.rpy:174
translate english ch1_2_2e03490c:

    # xs "可以这么理解。"
    xs "You can understand like that."

# game/scripts/c1/c1-2.rpy:184
translate english ch1_2_d7a5964e:

    # xs "这种情况也是很少见的，所以，你要加油啊。"
    xs "Cases like this are rare, so do your best."

# game/scripts/c1/c1-2.rpy:185
translate english ch1_2_2afc4536:

    # by eye_still o "……加什么油，加油去死吗？"
    by eye_still o "…Do my best at what — dying faster?" 

# game/scripts/c1/c1-2.rpy:188
translate english ch1_2_efd2e103:

    # xs "当然是加油解除诅咒。"
    xs "No. Do your best to lift the curse."

# game/scripts/c1/c1-2.rpy:189
translate english ch1_2_7a1d77fd:

    # by eye_move def "……哼……"
    by eye_move def "...Hmm..."

# game/scripts/c1/c1-2.rpy:190
translate english ch1_2_73e83c9b:

    # by eye_still o "所以，诅咒解除，就彻底没事了？"
    by eye_still o "So, if the curse is lifted, I will be completely fine?"

# game/scripts/c1/c1-2.rpy:193
translate english ch1_2_8e14be24:

    # xs "对，相当于什么都没发生过。你能活下来，也不会再有怪异影响你。"
    xs "Yes, it‘s equivalent to nothing having happened. You can survive, and there will no longer be any GuaiYi affecting you."

# game/scripts/c1/c1-2.rpy:194
translate english ch1_2_6f2002a8:

    # by eye_still o "哦……"
    by eye_still o "Okay..."

# game/scripts/c1/c1-2.rpy:197
translate english ch1_2_e3cca851:

    # xs "怎么，现在开始舍不得你身上的小鬼魂了？"
    xs "Well, now you‘re starting to be reluctant to part with your little ghost?"

# game/scripts/c1/c1-2.rpy:198
translate english ch1_2_7c8c2f03:

    # by eye_shock o "才没有！怎么可能！"
    by eye_shock o "No way! How could that be!"

# game/scripts/c1/c1-2.rpy:201
translate english ch1_2_04edfcf4:

    # xs "……"
    xs "..."

# game/scripts/c1/c1-2.rpy:204
translate english ch1_2_27e64198:

    # xs "嗯，那就好。"
    xs "Well, that would be fine."

# game/scripts/c1/c1-2.rpy:207
translate english ch1_2_9865d74d:

    # "西顺挑了挑眉，看着白一轻笑了一会。{p}但她没有继续调侃下去，而是很快收起了笑容。"
    "Xishun raised his eyebrows, looked at Bai Yi and chuckled for a while. {p}But she did not continue teasing, but quickly put away her smile."

# game/scripts/c1/c1-2.rpy:210
translate english ch1_2_fa7a1433:

    # xs "像你们这种情况，共感，同知，可以算是每时每刻在一起。"
    xs "In a situation like yours, sharing the same feelings and knowing each other can be considered as being together every moment."

# game/scripts/c1/c1-2.rpy:211
translate english ch1_2_fd90d248:

    # xs "你的小鬼魂能感受你的身体，也能跟你一起思考，你们互相提醒，对于你们解除诅咒是有好处的。"
    xs "Your little ghost can feel your body and can think with you, and you can remind each other. All of that are beneficial for you to lift the curse."

# game/scripts/c1/c1-2.rpy:214
translate english ch1_2_bbd3cb43:

    # xs "但是，你们要知道，这些都只是为了解除诅咒，千万不要对此投入太多感情……你们都是。"
    xs "However, you have to know that these are just to lift the curse, don't be too emotionally invested in it...y'all."

# game/scripts/c1/c1-2.rpy:217
translate english ch1_2_58687939:

    # xs "不要被吊桥效应影响。"
    xs "Don't be affected by the drawbridge effect."

# game/scripts/c1/c1-2.rpy:218
translate english ch1_2_78bc14e6:

    # by eye_still def "……哦。你要教我做事？"
    by eye_still def "...oh. You want to teach me how to do things?"

# game/scripts/c1/c1-2.rpy:219
translate english ch1_2_3ec286e7:

    # "白一皱起眉毛，语气立马冷了下来，对西顺的提醒嗤之以鼻。"
    "Bai Yi frowned, with her tone immediately turning cold, and she sneered at Xi Shun's reminder"

# game/scripts/c1/c1-2.rpy:220
translate english ch1_2_25ee45ee:

    # by eye_still o "解决这种问题本来就是你们的工作内容吧。我是会配合，但这可不是我的责任。"
    by eye_still o "Solving this kind of problem is part of your job, isn't it? I'll cooperate, but this isn't my responsibility."

# game/scripts/c1/c1-2.rpy:223
translate english ch1_2_9a78d24a:

    # xs "不，并不是你想的那样。这只是例行的提醒而已。"
    xs "No, it's not what you think. This is just a routine reminder."

# game/scripts/c1/c1-2.rpy:224
translate english ch1_2_0f1b545f:

    # by eye_close o "……呵呵。"
    by eye_close o "...Huh."

# game/scripts/c1/c1-2.rpy:225
translate english ch1_2_b3953779:

    # "白一只是冷笑一声，也懒得对这句话做出直接回答。"
    "Bai Yi just sneered and did not directly answer this question."

# game/scripts/c1/c1-2.rpy:228
translate english ch1_2_3a45db8c:

    # xs "好，那么现在说第三件事。"
    xs "Just right, now let's talk about the third thing."

# game/scripts/c1/c1-2.rpy:229
translate english ch1_2_aac51d8c:

    # "西顺没有被白一的态度所影响，而是自然地接过了下一个话题。"
    "Xi Shun was not affected by Bai Yi's attitude, but took the next topic naturally."

# game/scripts/c1/c1-2.rpy:230
translate english ch1_2_fd760843:

    # xs "温心的房间。关于我们之前推测的垃圾桶，暂时还没有发现对应的证据。"
    xs "About Wen Xin's Room. Regarding the trash can we previously speculated about, no corresponding evidence has been found so far."

# game/scripts/c1/c1-2.rpy:233
translate english ch1_2_b83de25f:

    # xs "可能已经被处理掉了，当然，也不排除不存在这个东西。"
    xs "It might have been disposed of, of course, it's also possible that it never existed."

# game/scripts/c1/c1-2.rpy:234
translate english ch1_2_4a5286e1:

    # by eye_still o "……所以？"
    by eye_still o "...So?"

# game/scripts/c1/c1-2.rpy:237
translate english ch1_2_ca3bed2c:

    # xs "虽然暂时没找到，但是这个思路是没有问题的，可以继续往下排查，只是——"
    xs "Although we haven't found anything yet, the approach is sound, and we can continue investigating, but —"

# game/scripts/c1/c1-2.rpy:240
translate english ch1_2_429bf95d:

    # by eye_def o "哦，总之你的意思就是全都回到原点了呗？"
    by eye_def o "Oh, so you mean everything's back to square one?"

# game/scripts/c1/c1-2.rpy:241
translate english ch1_2_70a9281b:

    # by eye_close e "都说了这是你们的工作，你什么都查不出来，却只会跟我说有的没的，只会教我做事？"
    by eye_close e "I said that this is your job, and it is you that can't find anything. But you only tell me useless things and try to tell me what to do?"

# game/scripts/c1/c1-2.rpy:242
translate english ch1_2_fbdc8f2b:

    # by eye_still o "像你这样做事，能查到什么东西？能查到才有鬼。"
    by eye_still o "With the way you're doing things, how can you find anything? It would be a miracle if you did."

# game/scripts/c1/c1-2.rpy:245
translate english ch1_2_4dba63a0:

    # xs "首先，你冷静一点，不要再发挥你的臆想了。"
    xs "First, you need to calm down and stop playing with your imagination."

# game/scripts/c1/c1-2.rpy:246
translate english ch1_2_2198c8e4_1:

    # by eye_still "……"
    by eye_still "..."

# game/scripts/c1/c1-2.rpy:247
translate english ch1_2_9b2a0415:

    # "面对白一的刻意挑衅，西顺的表情没有任何变化，这让白一有一种一拳打到棉花上的感觉，蓄起来的气无处可发。"
    "Faced with Bai Yi’s deliberate provocation, Xi Shun remained completely unmoved. The lack of reaction left Bai Yi feeling as though she had struck air, her pent-up anger with nowhere to go."

# game/scripts/c1/c1-2.rpy:248
translate english ch1_2_10368d52:

    # by eye_close o "哦，知道了。"
    by eye_close o "Oh, I see."

# game/scripts/c1/c1-2.rpy:249
translate english ch1_2_a54b0fb9:

    # "但她也没有要配合的意思，只是沉默地盯着西顺，而后从椅子上站了起来。"
    "But she didn't intend to cooperate either, she just silently stared at Xi Shun, and then stood up from the chair."

# game/scripts/c1/c1-2.rpy:250
translate english ch1_2_444a0294:

    # by eye_close def "我先——"
    by eye_close def "I will go first —"

# game/scripts/c1/c1-2.rpy:253
translate english ch1_2_f20930a1:

    # by eye_shock e "嘶——"
    by eye_shock e "Hiss —"

# game/scripts/c1/c1-2.rpy:254
translate english ch1_2_8609d0a6:

    # "即将转身时，一道黑影在眼前飞速闪过。"
    "Just as she was about to turn around, a dark shadow flashed past her eyes."

# game/scripts/c1/c1-2.rpy:256
translate english ch1_2_a52e7b4e:

    # "随后，白一的手腕被扣住，停在了原地。"
    "Then, Bai Yi's wrist was grabbed, stopping her in her tracks."

# game/scripts/c1/c1-2.rpy:257
translate english ch1_2_0bed68d3:

    # "力气之大，令白一忍不住下意识吸了口凉气。"
    "The force was so strong that Bai Yi couldn't help but instinctively gasp."

# game/scripts/c1/c1-2.rpy:260
translate english ch1_2_ac749ea4:

    # by eye_shock e "你要干嘛？！"
    by eye_shock e "What do you want?!"

# game/scripts/c1/c1-2.rpy:261
translate english ch1_2_3d36d666:

    # "西平突然站起身，用力抓住了她的手腕。"
    "Xi Ping suddenly stood up and grabbed her wrist forcefully."

# game/scripts/c1/c1-2.rpy:264
translate english ch1_2_caa54cdc:

    # xp "你等一下，先听她说完。"
    xp "Wait a moment, let her finish."

# game/scripts/c1/c1-2.rpy:268
translate english ch1_2_f33f0728:

    # "西平只是这么说着，放开了手，而后又恢复到平时那没什么存在感的状态。"
    "Xi Ping just said that, released her hand, and then returned to her usual inconspicuous state."

# game/scripts/c1/c1-2.rpy:269
translate english ch1_2_e1537b49:

    # "然而现在，白一可不信她真的没有什么存在感……"
    "However, now, Bai Yi didn't believe that she was really inconspicuous..."

# game/scripts/c1/c1-2.rpy:270
translate english ch1_2_88b87e96:

    # "不如说，她更像是某种蛰伏的动物，一直观察着白一和西顺。"
    "Rather, she was more like some kind of lurking animal, constantly observing Bai Yi and Xi Shun."

# game/scripts/c1/c1-2.rpy:271
translate english ch1_2_324ba1ef:

    # "而稍有不对，就会露出獠牙。"
    "And if anything went wrong, she would bare her fangs."

# game/scripts/c1/c1-2.rpy:272
translate english ch1_2_b2b7537a:

    # "——当然，是对白一露出獠牙。"
    "— Of course, it was Bai Yi who bared his fangs."

# game/scripts/c1/c1-2.rpy:273
translate english ch1_2_9c736e97:

    # by eye_wacky e "我只是想说我要先去个洗手间！{size=23}……顺便拖延一下时间……{/size}你们又要怎样啊？？"
    by eye_wacky e "I just wanted to say that I need to go to the bathroom first! {size=23}... By the way, stall for time... {/size} What do you guys want??"

# game/scripts/c1/c1-2.rpy:274
translate english ch1_2_5b012e31:

    # "夹在中间的那句抱怨很小声，没人听见。当然，除了我。"
    "The complaint in the middle was so quiet that no one heard it. Except me, of course."

# game/scripts/c1/c1-2.rpy:275
translate english ch1_2_c19199ed:

    # "西平顿了顿，而后微微颔首，算是同意了。"
    "Xi Ping paused for a moment, then nodded slightly, agreeing."

# game/scripts/c1/c1-2.rpy:277
translate english ch1_2_1ca41108:

    # xp "抱歉，我刚刚有些着急。"
    xp "Sorry, I was a little anxious just now."

# game/scripts/c1/c1-2.rpy:278
translate english ch1_2_f3c42708:

    # by eye_still o "哦。"
    by eye_still o "Oh."

# game/scripts/c1/c1-2.rpy:279
translate english ch1_2_29eca752:

    # "白一冷冷地应了一声，转身推门出去了。"
    "Bai Yi responded coldly, turned around, and pushed the door open to leave."

# game/scripts/c1/c1-2.rpy:282
translate english ch1_2_69840969:

    # by eye_wacky o "哇靠——她的力气也太大了吧？！这合理吗？"
    by eye_wacky o "Damn. Her strength is too much, isn't it?! Is this even reasonable?"

# game/scripts/c1/c1-2.rpy:283
translate english ch1_2_85aa0bbc:

    # "进到洗手间的小隔间，白一强撑的气势立马就泄了下来。"
    "Once inside the small cubicle of the restroom, Bai Yi's forced composure immediately crumbled."

# game/scripts/c1/c1-2.rpy:284
translate english ch1_2_a0d391ae:

    # by eye_close o "超级痛，是吧？突然抓着我的手，还那么用力，连手臂都一起扯到了。"
    by eye_close o "It hurts so much, right? Suddenly grabbing my hand, and so forcefully, she even pulled my arm along with it."

# game/scripts/c1/c1-2.rpy:285
translate english ch1_2_ce4cd36b:

    # by eye_wacky e "我差点以为我的手要断了，至于吗？真受不了……"
    by eye_wacky e "I almost thought my hand was going to break, is that really necessary? I can't stand it..."

# game/scripts/c1/c1-2.rpy:286
translate english ch1_2_a5c3265a:

    # me "嗯……有点。"
    me "Um... a little."

# game/scripts/c1/c1-2.rpy:287
translate english ch1_2_96d10ea4:

    # me "但是……主要是因为，你手上有伤吧……你之前弄的那些……"
    me "But... mainly because, you have injuries on your hand, right... those ones you got before..."

# game/scripts/c1/c1-2.rpy:288
translate english ch1_2_21de89ae:

    # "白一抱怨的声音一下停住。而后，声音变得更加冷硬。"
    "Bai Yi's complaining voice stopped abruptly. Then, her voice became even colder and harder."

# game/scripts/c1/c1-2.rpy:289
translate english ch1_2_8d40ae00:

    # by eye_still def "哦，对啊。"
    by eye_still def "Oh, that's right."

# game/scripts/c1/c1-2.rpy:290
translate english ch1_2_c04d4769:

    # by eye_wacky smile "是又怎样？你不喜欢吗？"
    by eye_wacky smile "So what? Don't you like it?"

# game/scripts/c1/c1-2.rpy:291
translate english ch1_2_3d4a4c95:

    # me "不……我没那么说……嘶。"
    me "No... I didn't say that... Ow."

# game/scripts/c1/c1-2.rpy:292
translate english ch1_2_fe3521f8:

    # by eye_close def "可惜了，那你也只能受着。"
    by eye_close def "So unlucky, then you'll just have to endure it."

# game/scripts/c1/c1-2.rpy:294
translate english ch1_2_8c8e4c7f:

    # "她撩起左手的袖口，又在伤口上用力捏了一把。"
    "She pulled up the sleeve of her left hand and pinched the wound hard again."

# game/scripts/c1/c1-2.rpy:295
translate english ch1_2_5a939b8d:

    # me "喂……"
    me "Hey..."

# game/scripts/c1/c1-2.rpy:296
translate english ch1_2_6a2527ac:

    # "我没想到只是稍微提一嘴，她的反应就那么大。"
    "I didn't expect her reaction to be so strong just from a casual mention."

# game/scripts/c1/c1-2.rpy:297
translate english ch1_2_2fe34d98:

    # "说到底，我其实也没有非要问出什么的意思，只是难免会有些好奇而已……"
    "Ultimately, I didn't really intend to ask anything specific, I was just a little curious..."

# game/scripts/c1/c1-2.rpy:298
translate english ch1_2_a2d4be3b:

    # "毕竟，那些伤痕深深浅浅、十分密集，很明显不是最近这一次就能弄成的样子。"
    "After all, those wounds were deep and shallow, very dense, and clearly not something that could be done just this last time."

# game/scripts/c1/c1-2.rpy:299
translate english ch1_2_f62c8f6a:

    # "但……"
    "But..."

# game/scripts/c1/c1-2.rpy:300
translate english ch1_2_d17575d7:

    # me "嘶……"
    me "Ow..."

# game/scripts/c1/c1-2.rpy:301
translate english ch1_2_ad503540:

    # "又一阵尖锐的刺痛随着白一的动作产生，疼得我恍惚一瞬，忘了思考。"
    "Bai Yi moved, and another sharp pain tore through me, leaving me dazed for a moment, my mind blank."

# game/scripts/c1/c1-2.rpy:302
translate english ch1_2_6f50c41a:

    # by eye_still e "没有不喜欢就好。而且，你不觉得很爽吗？"
    by eye_still e "It's good that you don't dislike it. Besides, don't you think it feels great?"

# game/scripts/c1/c1-2.rpy:303
translate english ch1_2_f73daca8:

    # "最新的伤口好像有些裂开了，暴露在冰冷的空气里。"
    "The newest wound seemed to have split open, exposed to the cold air."

# game/scripts/c1/c1-2.rpy:305
translate english ch1_2_0515a846:

    # me "……不觉得。"
    me "...I don't think so."

# game/scripts/c1/c1-2.rpy:306
translate english ch1_2_41909f9e:

    # by eye_close smile "噢，但我觉得。"
    by eye_close smile "Oh, but I do think so."

# game/scripts/c1/c1-2.rpy:307
translate english ch1_2_1834d120_1:

    # me "……"
    me "..."

# game/scripts/c1/c1-2.rpy:308
translate english ch1_2_206f589e:

    # by eye_def o "那抱歉了。不过，你也没办法，毕竟这还是我的身体。"
    by eye_def o "Well, I'm sorry? But you can‘t help it. After all, this is still my body."

# game/scripts/c1/c1-2.rpy:309
translate english ch1_2_150d488c:

    # "白一有些恶劣地笑了笑，而我不知道该如何回复，只好轻轻地叹了口气。"
    "Bai Yi gave me a faintly malicious smile. I didn’t know how to respond, so I let out a soft sigh."

# game/scripts/c1/c1-2.rpy:310
translate english ch1_2_01b8d389:

    # "话题突兀地结束，没有人想要继续说什么，于是继续的只有沉默。"
    "The topic ended abruptly. No one wanted to continue the conversation, so only silence remained."

# game/scripts/c1/c1-2.rpy:313
translate english ch1_2_1e2d44db:

    # "从洗手间出去，白一在转角处看见了倚在墙边的西平。"
    "Leaving the restroom, Bai Yi saw Xiping leaning against the wall at the corner."

# game/scripts/c1/c1-2.rpy:314
translate english ch1_2_31db810c:

    # "她手里掐着一张便利贴，看到白一过来，眼神飞速地在手里的东西和白一身上来回扫过。"
    "Holding a sticky note, she glanced quickly between it and Bai Yi as he approached."

# game/scripts/c1/c1-2.rpy:316
translate english ch1_2_424054cc:

    # by eye_def e "你怎么又来了？"
    by eye_def e "Why are you here again?"

# game/scripts/c1/c1-2.rpy:318
translate english ch1_2_b29be769:

    # xp "我想说，刚刚——{p}刚刚的事情，对不起。"
    xp "I wanted to say, just now —{p}I'm sorry about what happened just now."

# game/scripts/c1/c1-2.rpy:319
translate english ch1_2_7f9f15ca:

    # by eye_def def "……之前不是已经说过一遍了吗？"
    by eye_def def "...Didn't you already say that once?"

# game/scripts/c1/c1-2.rpy:320
translate english ch1_2_fbfaaac2:

    # "白一拧着眉毛，十分不解地看着西平。"
    "Bai Yi frowned, looking at Xiping with great confusion."

# game/scripts/c1/c1-2.rpy:321
translate english ch1_2_93590ae4:

    # xp "城安局，没打算继续查这个案件。"
    xp "CSA doesn't plan to continue investigating this case."

# game/scripts/c1/c1-2.rpy:322
translate english ch1_2_900a38b4:

    # by eye_def o "……啊？"
    by eye_def o "...What?"

# game/scripts/c1/c1-2.rpy:323
translate english ch1_2_5a52bb52:

    # xp "你——"
    xp "Hey you..."

# game/scripts/c1/c1-2.rpy:325
translate english ch1_2_3f66a3f9:

    # xs "喂，我说西平姐姐，你说的有事，该不会就是指偷偷找我的嫌疑人吧？"
    xs "Hey there, Xiping. That ‘something’ you mentioned… you don’t mean my suspect, do you?"

# game/scripts/c1/c1-2.rpy:328
translate english ch1_2_40fc2b03:

    # xp "……"
    xp "..."

# game/scripts/c1/c1-2.rpy:329
translate english ch1_2_6080c6f1:

    # "西顺忽然出现，声音打断了西平要说的话。"
    "Xi Shun suddenly appeared, her voice interrupting what Xi Ping was about to say."

# game/scripts/c1/c1-2.rpy:332
translate english ch1_2_b9b6a533:

    # "西平微微拧了拧眉毛，看向西顺，最终还是什么也没说。"
    "Xiping slightly furrowed her brows, looked at Xi Shun, but ultimately said nothing."

# game/scripts/c1/c1-2.rpy:334
translate english ch1_2_83953c08:

    # "她只是稍稍后退两步，又变成那副背景板的样子。"
    "She took a couple of steps back, fading into the background."

# game/scripts/c1/c1-2.rpy:335
translate english ch1_2_c72638c8:

    # by eye_wacky o "……你们到底要干嘛啊？别把我扯进去行不行。"
    by eye_wacky o "...What exactly do you two want to do? Can you please not drag me into this?"

# game/scripts/c1/c1-2.rpy:338
translate english ch1_2_51c27c1f:

    # xs "哎……"
    xs "Hey..."

# game/scripts/c1/c1-2.rpy:339
translate english ch1_2_16e48965:

    # xp "你没说我不能说那件事。"
    xp "You didn‘t say I couldn’t talk about that."

# game/scripts/c1/c1-2.rpy:342
translate english ch1_2_f9f1a16b:

    # xs "……我知道，我没在说你。"
    xs "..I know, I wasn't talking about you."

# game/scripts/c1/c1-2.rpy:343
translate english ch1_2_32e3040f:

    # "西顺轻轻拍了拍西平的背，然后回过头，冲着白一无奈地耸耸肩膀。"
    "Xi Shun gently patted Xiping's back, then turned around and shrugged helplessly at Bai Yi."

# game/scripts/c1/c1-2.rpy:346
translate english ch1_2_4e3815f5:

    # xs "好吧，大家都在这，还是回房间说吧。"
    xs "All right, everyone‘s here, let’s go back to the room and talk."

# game/scripts/c1/c1-2.rpy:347
translate english ch1_2_8b1c9fd6:

    # by eye_def o "哦……"
    by eye_def o "Okay..."

# game/scripts/c1/c1-2.rpy:352
translate english ch1_2_3a5f8018:

    # xs "之前说东西没查到，确实是不好查，但也有别的原因。"
    xs "I said before that we couldn't find the items, and it's true that they're difficult to find, but there are other reasons too."

# game/scripts/c1/c1-2.rpy:353
translate english ch1_2_bcec770b:

    # xs "城安局想要提前结案，他们也不让我继续查下去。"
    xs "CSA wants to close the case early, and they won't let me continue the investigation."

# game/scripts/c1/c1-2.rpy:354
translate english ch1_2_e44409f2:

    # by eye_def o "……怎么会这样？"
    by eye_def o "...Why?"

# game/scripts/c1/c1-2.rpy:357
translate english ch1_2_25c91fef:

    # xs "唔——这件事现在变得很复杂，而它“不值得”变得这么复杂。"
    xs "Hmm...this matter has become very complicated, and it's 'not worth' becoming this complicated."

# game/scripts/c1/c1-2.rpy:358
translate english ch1_2_e53f47d7:

    # by eye_wacky e "……哈？什么意思。能不能说清楚点。"
    by eye_wacky e "...Huh? What do you mean? Can you explain it more clearly?"

# game/scripts/c1/c1-2.rpy:359
translate english ch1_2_71d4ccfe:

    # "白一皱起眉——她最讨厌这样似是而非的说法。"
    "Bai Yi frowned. She hated such ambiguous statements."

# game/scripts/c1/c1-2.rpy:362
translate english ch1_2_8946dfb2:

    # xs "怎么说呢，嗯……"
    xs "How to put it, well..."

# game/scripts/c1/c1-2.rpy:363
translate english ch1_2_9e735d75:

    # "西顺看起来像在纠结什么，手指一下又一下地轻轻敲着桌面，发出有规律的轻响。"
    "Xi Shun seemed conflicted, her fingers tapping lightly on the table in a steady rhythm."

# game/scripts/c1/c1-2.rpy:366
translate english ch1_2_e036226d:

    # xs "现在能找到和案件有联系的人就三个，温心，你，报案人。"
    xs "Currently, there are only three people connected to the case: Wen Xin, you, and the person who reported the crime."

# game/scripts/c1/c1-2.rpy:369
translate english ch1_2_4336f5a9:

    # xs "温心是个孤儿，养她长大的奶奶也在不久之前去世了。而你——"
    xs "Wen Xin is an orphan, and the grandmother who raised her passed away not long ago. And you"

# game/scripts/c1/c1-2.rpy:371
translate english ch1_2_a5766c27:

    # by eye_def o "哦，我也是孤儿。"
    by eye_def o "Oh, I'm also an orphan."

# game/scripts/c1/c1-2.rpy:374
translate english ch1_2_8196631a:

    # xs "你——嗯？？你说什么？"
    xs "You...What? What did you say?"

# game/scripts/c1/c1-2.rpy:377
translate english ch1_2_ab3ce056:

    # "西顺罕见地愣住，一时间竟然没能接上话，只是呆呆地盯着白一。"
    "Xi Shun was unusually stunned, staring blankly at Bai Yi for a moment."

# game/scripts/c1/c1-2.rpy:380
translate english ch1_2_4bcc1430:

    # xs "{size=45}咳咳咳！！{/size}不是，你——"
    xs "{size=45}Cough cough cough!!{/size} No, you —"

# game/scripts/c1/c1-2.rpy:383
translate english ch1_2_ac14b61f:

    # by eye_move e "咳——反正，反正差不多就是了。"
    by eye_move e "Cough — anyway, anyway, it's pretty much the same."

# game/scripts/c1/c1-2.rpy:384
translate english ch1_2_7ee726c9:

    # "眼见西顺要说出什么，白一赶紧打断了她的话。"
    "Seeing that Xi Shun was about to say something, Bai Yi quickly interrupted her."

# game/scripts/c1/c1-2.rpy:385
translate english ch1_2_1c282ab1:

    # by eye_def o "我说，这不是重点吧？你要说什么就快点，别纠结这个。"
    by eye_def o "Hey, that's not the point, is it? Just get to the point, don't dwell on this."

# game/scripts/c1/c1-2.rpy:389
translate english ch1_2_d7f10157:

    # xs "好吧，这确实不重要。"
    xs "Well, that really isn‘t important."

# game/scripts/c1/c1-2.rpy:390
translate english ch1_2_9fcc600a:

    # xs "总体来说，你和温心都是没什么社会联系的人，是普通高中生。然后，报案人也是个普通的高中生。"
    xs "Overall, you and Wen Xin are both people with little social connection, ordinary high school students. And the person who reported the incident was also an ordinary high school student."

# game/scripts/c1/c1-2.rpy:393
translate english ch1_2_81e886ce:

    # xs "像你们……你们这样的事情，过程很麻烦，但是涉案人和结果都很简单，不值得动用这么多资源查。"
    xs "Cases like this can get messy on paper, but in reality, the people and outcome are straightforward. Not worth wasting a ton of resources on it."

# game/scripts/c1/c1-2.rpy:394
translate english ch1_2_2528b15b:

    # by eye_wacky def "哦，我懂了。"
    by eye_wacky def "Ok, I understand."

# game/scripts/c1/c1-2.rpy:395
translate english ch1_2_5123eec1:

    # by eye_close o "就是温心死掉也没什么关系，我有什么事也没什么关系，因为没人在意，是吧？"
    by eye_close o "So it doesn't matter if Wenxin died, and it doesn't matter what happens to me, because nobody cares, right?"

# game/scripts/c1/c1-2.rpy:398
translate english ch1_2_99aa0fe0:

    # xs "嗯……你想这么理解，那也可以。"
    xs "Well... if you want to understand it that way, that's fine."

# game/scripts/c1/c1-2.rpy:399
translate english ch1_2_b91054db:

    # "西顺并没有直接承认，但她的态度跟直接认同白一没什么区别。"
    "Xi Shun didn't directly admit it, but her attitude was no different from directly agreeing with Bai Yi."

# game/scripts/c1/c1-2.rpy:402
translate english ch1_2_c202eed8:

    # xs "这不是我的想法。"
    xs "That's not what I think."

# game/scripts/c1/c1-2.rpy:403
translate english ch1_2_b88fdb50:

    # "她强调一遍，轻轻叹了口气，而后抬起手用力捏了捏眉心。"
    "She emphasized it again, sighed softly, and then raised her hand to rub her temples."

# game/scripts/c1/c1-2.rpy:404
translate english ch1_2_755db9ce:

    # by eye_def def "哦，那又怎样？"
    by eye_def def "Oh, so what?"

# game/scripts/c1/c1-2.rpy:405
translate english ch1_2_c564d66d:

    # "是谁怎么想都无所谓，白一只是冷淡地看着西顺继续说。"
    "It didn't matter what anyone thought, and Bai Yi just coldly watched Xishun continue."

# game/scripts/c1/c1-2.rpy:408
translate english ch1_2_2236b1c6:

    # xs "昨天我收到通知，被要求马上结束调查这件事。而调查结果，可以有两个选择。"
    xs "Yesterday, I received a notification that I was asked to end the investigation immediately. As for the results of the investigation, there are two choices."

# game/scripts/c1/c1-2.rpy:409
translate english ch1_2_8d8198e1:

    # xs "一是公布温心是意外死亡，二是公布你是凶手。"
    xs "One is to announce that Wenxin died accidentally, and the other is to announce that you are the murderer."

# game/scripts/c1/c1-2.rpy:412
translate english ch1_2_2aaced2b:

    # by eye_close def "……"
    by eye_close def "..."

# game/scripts/c1/c1-2.rpy:413
translate english ch1_2_b6ef533c:

    # by eye_def def "哦。"
    by eye_def def "Oh."

# game/scripts/c1/c1-2.rpy:414
translate english ch1_2_01700b06:

    # by eye_def o "所以呢？那你是什么想法？跟我说这么多是什么意思？"
    by eye_def o "So? What are your thoughts? What's the point of telling me all this?"

# game/scripts/c1/c1-2.rpy:417
translate english ch1_2_0a611479:

    # xs "因为，你——"
    xs "Because, you..."

# game/scripts/c1/c1-2.rpy:418
translate english ch1_2_223f3208:

    # by eye_def o "说得很有道理啊，反正我也很可能是凶手，这样不就是直接搞定了，根本不用麻烦那么多事。"
    by eye_def o "That makes perfect sense. After all, I’m the most likely murderer—case closed, no trouble at all."

# game/scripts/c1/c1-2.rpy:419
translate english ch1_2_ea36f819:

    # by eye_still e "还是说，你的意思是，把这些告诉我，让我看看你是不会那样做的，和其他人不一样。"
    by eye_still e "Or is that why you’re telling me all this? To show me you’d never do something like that? That you’re different from everyone else?"

# game/scripts/c1/c1-2.rpy:420
translate english ch1_2_90126d21:

    # by eye_def o "要让我对你感激涕零吗？"
    by eye_def o "What, do you want me to be grateful to you forever?"

# game/scripts/c1/c1-2.rpy:423
translate english ch1_2_98f6cbab:

    # xs "……不，你不要这么想。"
    xs "...No, don't think that."

# game/scripts/c1/c1-2.rpy:426
translate english ch1_2_680d1d79:

    # xs "我不需要你的感谢，我需要你的帮助。"
    xs "I don't need your gratitude, I need your help."

# game/scripts/c1/c1-2.rpy:427
translate english ch1_2_9033321c:

    # by eye_wacky o "……啊？"
    by eye_wacky o "...What?"

# game/scripts/c1/c1-2.rpy:430
translate english ch1_2_d21d746a:

    # xs "如你所见，因为城安局，如果我想要自己查东西，反而会受到阻碍。所以，有些事情需要你帮我去做。"
    xs "As you can see, because of the CSA, if I wanted to investigate things myself, I would instead be hindered. So, there are some things I need you to do for me."

# game/scripts/c1/c1-2.rpy:431
translate english ch1_2_8aa29f13:

    # by eye_move o "哦……免费劳动力是吧。"
    by eye_move o "Oh... free labor, right?"

# game/scripts/c1/c1-2.rpy:432
translate english ch1_2_f33a4c1c:

    # "白一了然，但又有些疑惑。"
    "Bai Yi understood, but was also a little confused."

# game/scripts/c1/c1-2.rpy:433
translate english ch1_2_94bddb44:

    # by eye_def e "所以……意思是这么麻烦的事情，你还要继续？而且，你这样不算违规？"
    by eye_def e "So... you mean you're going to continue with this troublesome matter? And, isn't this against the rules?"

# game/scripts/c1/c1-2.rpy:436
translate english ch1_2_23a4ac13:

    # xs "嗯，我自然有我的方法，你不用在意这个。"
    xs "Well, I have my ways, but you don't have to worry about that."

# game/scripts/c1/c1-2.rpy:439
translate english ch1_2_6526a888:

    # "西顺轻咳两声，很快带过这点，显然也是不想多说。"
    "Xi Shun coughed lightly, quickly glossing over this point, clearly not wanting to say more."

# game/scripts/c1/c1-2.rpy:442
translate english ch1_2_605c0cc4:

    # xs "首先，现在明显还有疑点。嫌疑很重，也不代表真的是凶手。"
    xs "First, there are still obvious doubts. Strong suspicion doesn't mean they're definitely the murderer."

# game/scripts/c1/c1-2.rpy:443
translate english ch1_2_46716605:

    # xs "其次，就算是你杀了她，也不是让你不明不白地在三个月之后失去生命的理由。这是两码事。"
    xs "Secondly, even if you killed her, that's not a reason for you to lose your life inexplicably three months later. These are two different things."

# game/scripts/c1/c1-2.rpy:446
translate english ch1_2_e00ecb5b:

    # xs "最后……"
    xs "Finally..."

# game/scripts/c1/c1-2.rpy:449
translate english ch1_2_60496e92:

    # xs "你不想知道真相吗？"
    xs "Don't you want to know the truth?"

# game/scripts/c1/c1-2.rpy:450
translate english ch1_2_fdfd950b:

    # "想知道吗？"
    "Do you want to know?"

# game/scripts/c1/c1-2.rpy:451
translate english ch1_2_29c5bb1a_1:

    # by eye_def def "……"
    by eye_def def "..."

# game/scripts/c1/c1-2.rpy:452
translate english ch1_2_8f6e9bc9:

    # "要让事情就这么过去吗？"
    "Do you just let the things go?"

# game/scripts/c1/c1-2.rpy:453
translate english ch1_2_6464bf6c:

    # by eye_move def "……"
    by eye_move def "..."

# game/scripts/c1/c1-2.rpy:456
translate english ch1_2_8808a2cc:

    # "白一陷入了沉默，没有回话。"
    "Bai Yi fell silent, not replying."

# game/scripts/c1/c1-2.rpy:457
translate english ch1_2_d91d0b47:

    # "西顺也并不显得着急，只是静静地看着她的眼睛。"
    "Xi Shun didn't seem anxious, just quietly looking into her eyes."

# game/scripts/c1/c1-2.rpy:458
translate english ch1_2_9885d028:

    # by eye_close o "好吧，我知道了。"
    by eye_close o "Okay, I know that."

# game/scripts/c1/c1-2.rpy:459
translate english ch1_2_e5163438:

    # by eye_move e "我听你的就是了。{size=23}反正我也没资格拒绝吧……{/size}"
    by eye_move e "I'll listen to you. {size=23}Anyway, I don't have the right to refuse, do I?{/size}"

# game/scripts/c1/c1-2.rpy:460
translate english ch1_2_c2fa8566:

    # by eye_def o "那所以现在这是要干嘛？"
    by eye_def o "So what are we going to do now?"

